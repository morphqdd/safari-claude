{
  "manifest_version": 2,
  "name": "Safari Agent",
  "version": "0.1.0",
  "description": "Lets a local agent drive a single Safari tab.",
  "permissions": ["tabs", "storage", "<all_urls>"],
  "background": { "scripts": ["bg/link.js", "bg/handlers.js", "background.js"], "persistent": true },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "run_at": "document_idle",
      "js": [
        "content/snapshot.js",
        "content/risk.js",
        "content/sites.js",
        "content/overlay.js",
        "content/actions.js",
        "content/main.js"
      ]
    }
  ],
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "browser_action": { "default_title": "Safari Agent", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } }
}
