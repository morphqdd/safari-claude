{
  "manifest_version": 3,
  "name": "SC Wake Spike",
  "version": "0.0.1",
  "description": "Throwaway: can a helper wake this service worker, and does it stay alive?",
  "permissions": ["tabs", "scripting", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "scripts": ["background.js"], "persistent": false },
  "action": { "default_title": "SC Wake Spike — connect" },
  "commands": {
    "sc-wake": {
      "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "MacCtrl+Shift+Y" },
      "description": "Wake and connect"
    }
  }
}
